# Where the PRISM backend runs. In development /api is proxied to this address (vite.config.ts).
VITE_PROXY_TARGET=http://localhost:8000
# Production builds talking to a backend on another origin: its absolute URL (leave empty for same origin)
VITE_API_URL=
# api = talk to the backend; fixtures = use the saved sample responses in src/fixtures (offline backup)
VITE_DATA_MODE=api
# live = real sign-in; mock = no sign-in, X-Mock-Role header (backend MOCK_MODE=true, developers only)
VITE_AUTH_MODE=live
# true = include the developer tools (demo quick sign-in, role switcher, presenter mode). Off for public builds.
VITE_DEV_TOOLS=false
