# PRISM Engine backend configuration. Copy to .env and adjust.
APP_ENV=dev
# true  -> every endpoint returns schema-identical fixtures (no DB needed)
# false -> live services (DB + engine). Live mode is wired in Phases 1-7.
MOCK_MODE=true
DATABASE_URL=sqlite:///./prism.db
# DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism
JWT_SECRET=change-me-in-production-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Optional path to Person 3's model artefact; absent -> deterministic cosine fallback
ML_MODEL_PATH=
ML_ALPHA=0.5
LOG_LEVEL=INFO
# Demo: enables /api/v1/demo/* (personas, reset, walkthrough). Set false in production.
DEMO_MODE=true
# Frozen "today" used for deadlines and roadmap dates during the demo (YYYY-MM-DD); empty = real date
DEMO_TODAY=2026-10-07
