# PRISM Engine backend configuration. Copy to .env and adjust.
APP_ENV=dev
# true  -> every endpoint returns schema-identical fixtures (no DB needed)
# false -> live services (DB + engine). Run `python scripts/seed.py` first.
MOCK_MODE=true
DATABASE_URL=sqlite:///./prism.db
# DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism
JWT_SECRET=change-me-in-production-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Optional path to Person 3's model artefact; absent -> deterministic cosine fallback
ML_MODEL_PATH=
ML_ALPHA=0.5
LOG_LEVEL=INFO
# Optional live job-postings feed for market signals (free key: https://developer.adzuna.com).
# Leave empty to run on the versioned snapshot only; the API says so in /system/data-status.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_BUDGET=200
# Demo: enables /api/v1/demo/* (personas, reset, walkthrough). Set false in production.
DEMO_MODE=true
# Frozen "today" used for deadlines and roadmap dates during the demo (YYYY-MM-DD); empty = real date
DEMO_TODAY=2026-10-07
# Optional language model for plain-language summaries and Tamil/Hindi translation (never used for scoring).
# Any OpenAI-compatible endpoint works. Empty key = fixed templates. Calls are made by this server, so the
# server needs internet access to the endpoint (a blocked campus network falls back to templates).
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
GROK_TIMEOUT_SEC=12
# Deadline reminders (scripts/send_reminders.py, run daily). console = log only; twilio = SMS / WhatsApp.
# India: SMS needs DLT registration of sender ID and templates; WhatsApp needs approved message templates.
REMINDER_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=
